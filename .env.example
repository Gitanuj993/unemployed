# Copy to .env and adjust if needed. The backend reads these at startup.

# Postgres (matches docker-compose.yml). Host-side connection uses localhost.
DATABASE_URL=postgresql+psycopg://jobsearch:jobsearch@localhost:5432/jobsearch

# Local LLM runtime + model. llama3.2:3b is small/fast; llama3.1:8b is higher
# quality but a bigger download and slower on CPU.
# 11435 is our docker-compose Ollama. A native Ollama install owns 11434, so we
# deliberately avoid it. To use a native install instead, set this to 11434 and
# set OLLAMA_MODEL to a model that install actually has (`ollama list`).
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=llama3.2:3b

# Embedding model — ONE model for everything that gets compared (KB + jobs).
# If you change the model, update EMBEDDING_DIM to its output dimension.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
